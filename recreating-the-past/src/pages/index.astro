---
import archive from "../data/archive.json";
import RecreationsArchive from "../components/RecreationsArchive.jsx";
import { SITE_URL, SITE_NAME, OG_IMAGE } from "../site.js";
import "../styles/top-nav.css";

const title = "Recreating the Past";
const description = "An archive of student recreations of works by pioneers of computational and media art — a course taught by Zach Lieberman at the MIT Media Lab.";
const path = "/";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={SITE_URL + path} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#0f0f0f" />
		<!-- Open Graph / social preview -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={SITE_URL + path} />
		<meta property="og:image" content={SITE_URL + OG_IMAGE} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={SITE_URL + OG_IMAGE} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
	</head>

	<body>
		<RecreationsArchive archive={archive} client:load />
	</body>
</html>
